{
  "uid": "overwatch-pipeline",
  "title": "Overwatch — Pipeline Health",
  "description": "Is the pipeline keeping up, and is anything falling over. Read the top row first: it answers both questions in five numbers.",
  "tags": [
    "overwatch",
    "platform"
  ],
  "timezone": "Africa/Johannesburg",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Fraud Overview",
      "type": "dashboards",
      "tags": [
        "fraud"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is the pipeline keeping up?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Services up",
      "description": "All three of engine, API and simulator should be up. This counts scrape targets answering, so it goes red on a crash and also on a service that is running but has stopped serving its actuator endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "count(up{job=~\"fraud-engine|fraud-api|transaction-simulator\"} == 1)",
          "legendFormat": "of 3 up",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Consumer lag",
      "description": "Records sitting on the topic that the engine has not consumed yet — the one number that says whether detection is keeping pace with traffic. Zero means the engine is at the head of the topic. A figure that climbs steadily means transactions are arriving faster than they can be evaluated, and every alert is getting later. Note that this reads \"No data\" for the first half-minute after an engine restart: the per-partition lag gauge is only created once the consumer has been assigned a partition and completed a fetch, which is later than the container reports itself healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "records behind",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Published → processed gap",
      "description": "Transactions published to the stream over the dashboard's time range, minus those the engine processed in the same range. A handful either way is scrape skew and window edges — the two services are sampled at slightly different instants, and the engine may still be draining work published just before the window opened.\n\nDeliberately increase() over the range rather than the difference of the two raw counters. The raw form read -808139 once: the simulator had been rebuilt and restarted, so its in-process counter began again at zero while the engine's kept climbing, and subtracting two lifetime totals that no longer share a lifetime is meaningless. increase() understands a counter reset and only ever measures forward motion inside the window, so a restart of either service, or a metrics clear that removes both, leaves this panel honest.\n\nclamp_min at zero because the quantity is a count of transactions in flight, and there is no such thing as minus eight hundred thousand of them. A number that grows without coming back is real backlog or real loss.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "clamp_min(\n  sum(increase(simulator_published_total[$__range]))\n  - sum(increase(transactions_processed_total[$__range])),\n  0)",
          "legendFormat": "gap",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errors logged",
      "description": "ERROR-level log events across the selected services, over the dashboard's time range. Anything above zero has a stack trace behind it in `docker compose logs`.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(increase(logback_events_total{level=\"error\", service=~\"$service\"}[$__range]))",
          "legendFormat": "errors",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Transactions dropped",
      "description": "Transactions the engine could not process, over the dashboard's range, split by reason: `deserialization` is a message it could not read, `processing` is one it read and then failed on. Both counters are registered at zero on startup, so a green zero here means \"nothing has failed\" rather than \"nothing is reporting\".",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(transactions_failed_total[$__range]))",
          "legendFormat": "{{reason}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Published vs processed",
      "description": "The simulator's publish rate against the engine's processing rate. These two lines should sit on top of each other. A persistent gap between them is the same story the lag panel tells, seen as a rate rather than a backlog.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "published"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "processed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(simulator_published_total[$__rate_interval]))",
          "legendFormat": "published"
        },
        {
          "expr": "sum(rate(transactions_processed_total[$__rate_interval]))",
          "legendFormat": "processed"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer lag over time",
      "description": "Lag as a shape rather than a single number. A sawtooth is normal — it builds between polls and drains. A staircase that only goes up is the engine losing ground. Note that this reads \"No data\" for the first half-minute after an engine restart: the per-partition lag gauge is only created once the consumer has been assigned a partition and completed a fetch, which is later than the container reports itself healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (client_id) (kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{client_id}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Is every alert being announced?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Announcements queued",
      "description": "Alerts written to the outbox that are not yet on the fraud-alerts topic. The engine no longer sends to Kafka inside the transaction that saves an alert; it writes a row, and a poller drains it every 200ms. So this should sit at zero and flick up briefly: a figure that stays above zero means the poller is not keeping up or the broker is refusing writes, and every downstream consumer is hearing about fraud late. It reads zero rather than \"No data\" on a quiet pipeline, because the gauge is registered at startup.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(outbox_pending)",
          "legendFormat": "queued",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Oldest announcement waiting",
      "description": "How long the message at the front of the outbox queue has been waiting. Depth alone cannot tell a busy second from a stuck poller — a hundred messages published within a second of arriving is healthy, and one message sitting for ten minutes is not. This is the panel that distinguishes them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "max(outbox_oldest_pending_seconds)",
          "legendFormat": "seconds",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Announcements published vs failed",
      "description": "The drain rate of the outbox, against the rate at which sends are rejected. A failed send is not a lost alert — the row stays unpublished and the next poll retries it — so what this panel measures is how hard the poller is having to work, not how much has been lost. Sustained failures with a flat publish rate means the broker is unreachable and the queue above is growing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(outbox_published_total[5m]))",
          "legendFormat": "published/s"
        },
        {
          "expr": "sum(rate(outbox_publish_failed_total[5m]))",
          "legendFormat": "send failures/s"
        },
        {
          "expr": "sum(rate(fraud_alerts_enqueue_failed_total[5m]))",
          "legendFormat": "never queued/s"
        }
      ]
    },
    {
      "type": "row",
      "title": "How fast is detection?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Detection latency percentiles",
      "description": "Time to evaluate one transaction against the whole rule set, as quantiles over the exported histogram buckets. p99 is the number that matters: it is the experience of the transactions most likely to be the fraudulent ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fraud_detection_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_detection_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fraud_detection_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Detection latency distribution",
      "description": "The same histogram without the quantiles: every bucket, coloured by how many evaluations landed in it. This shows shape that percentile lines hide — two clusters of latency look identical to a p95 and very different here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "cellValues": {
          "unit": "none"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5,
          "fill": "dark-orange"
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        }
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(fraud_detection_latency_seconds_bucket[$__interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    },
    {
      "type": "row",
      "title": "Service internals",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Heap used",
      "description": "Heap as a fraction of the maximum the JVM will allow itself, rather than raw bytes — 400MB means nothing without knowing the ceiling, and the ceiling is a container limit nobody remembers. A sawtooth is healthy garbage collection. A rising floor is a leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\", service=~\"$service\"}) / sum by (service) (jvm_memory_max_bytes{area=\"heap\", service=~\"$service\"})",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC pause",
      "description": "Seconds of stop-the-world pause per second of wall clock, so 0.02 means 2% of the time is spent collecting rather than working. Detection latency and GC pause tend to move together, which is why they are on the same screen.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(jvm_gc_pause_seconds_sum{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Per-process CPU, as a fraction of everything available to the container. The simulator sitting near zero while the engine works is the expected shape: generating a transaction is cheap, evaluating one against every rule is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "description": "Requests per second by service. The API's traffic is the dashboard polling it; the simulator's is the control panel. A flat line here while the UI is open means the UI has lost the API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95",
      "description": "95th percentile response time per service, from the histogram buckets the services publish. The dashboard's own polling is in here, so a spike usually means a slow query rather than a slow network.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database connections",
      "description": "Hikari pool, per service. `pending` is the one to watch: a connection request that had to wait is a query queued behind the pool size, and it shows up as latency everywhere else on this dashboard before it shows up as an error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*pending.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (hikaricp_connections_active{service=~\"$service\"})",
          "legendFormat": "{{service}} active"
        },
        {
          "expr": "sum by (service) (hikaricp_connections_idle{service=~\"$service\"})",
          "legendFormat": "{{service}} idle"
        },
        {
          "expr": "sum by (service) (hikaricp_connections_pending{service=~\"$service\"})",
          "legendFormat": "{{service}} pending"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "How long each service has been running. A value that keeps resetting is a container in a crash loop — which the \"Services up\" tile will not catch if it restarts fast enough between scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "max by (service) (process_uptime_seconds{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ]
    }
  ]
}
