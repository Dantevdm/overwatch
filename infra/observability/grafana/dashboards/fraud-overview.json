{
  "uid": "overwatch-fraud",
  "title": "Overwatch — Fraud Overview",
  "description": "What the rules are catching. Every tile and pie on this dashboard is scoped to the time picker, so changing the range changes the numbers.",
  "tags": [
    "overwatch",
    "fraud"
  ],
  "timezone": "Africa/Johannesburg",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Pipeline Health",
      "type": "dashboards",
      "tags": [
        "platform"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    },
    {
      "title": "Rule Performance",
      "type": "dashboards",
      "tags": [
        "rules"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Transactions",
      "description": "Transactions processed within the dashboard's time range. This counts the increase over the window rather than the lifetime total, so it answers the question the time picker implies — change the range and this number changes with it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(increase(transactions_processed_total[$__range]))",
          "legendFormat": "transactions",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Alerts",
      "description": "Alerts raised in the same window. Note that LOW never appears: a LOW score does not reach the alerting threshold, so it is scored and recorded but never raised.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#c81e42"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(increase(fraud_alerts_total[$__range]))",
          "legendFormat": "alerts",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Alert rate",
      "description": "Alerts as a percentage of transactions over the window. The simulator injects fraud at a configurable rate, so this should track that setting — a figure far above it means the rules are firing on ordinary traffic, which is how an analyst learns to ignore them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(increase(fraud_alerts_total[$__range])) / clamp_min(sum(increase(transactions_processed_total[$__range])), 1)",
          "legendFormat": "alert rate",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Value flagged",
      "description": "Total rand value of the transactions flagged in this window. This is exposure, not loss — a flagged transaction is one an analyst should look at, not one confirmed fraudulent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyZAR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8f1030"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(increase(fraud_amount_flagged_zar_sum[$__range]))",
          "legendFormat": "flagged",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput vs alerts",
      "description": "Transactions per second against alerts per second, on the same axes. Alerts should be a small, steady fraction of throughput; a step change in one without the other is worth explaining.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "transactions/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alerts/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c81e42"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(transactions_processed_total[$__rate_interval]))",
          "legendFormat": "transactions/s"
        },
        {
          "expr": "sum(rate(fraud_alerts_total[$__rate_interval]))",
          "legendFormat": "alerts/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Alerts by severity",
      "description": "Stacked, so the height is the total alert rate and the bands are its composition. Colours match the Overwatch UI, so CRITICAL is the same crimson in both places.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "LOW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f87186"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MEDIUM"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ef4462"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HIGH"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c81e42"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8f1030"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (severity) (rate(fraud_alerts_total[$__rate_interval]))",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Severity mix",
      "description": "The composition of the alerts raised in this window. A mix dominated by MEDIUM is the healthy shape; a wedge of CRITICAL that keeps growing is either a real attack or a rule that has been over-weighted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "LOW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f87186"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MEDIUM"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ef4462"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HIGH"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c81e42"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8f1030"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum by (severity) (increase(fraud_alerts_total[$__range]))",
          "legendFormat": "{{severity}}",
          "instant": true
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Transactions by merchant category",
      "description": "Where the traffic is going in this window. The crypto, gambling and forex categories are on the rule watchlist, so their share here is the denominator for the watchlist rule's hit rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "expr": "sum by (category) (increase(transactions_processed_total[$__range]))",
          "legendFormat": "{{category}}",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "category",
              "Last *": "transactions"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "transactions",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Transactions by channel",
      "description": "POS, ONLINE, ATM. Channel is recorded on every transaction and is what several rules key off — CROSS_BORDER and the online-only patterns read very differently against an ATM-heavy mix.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "expr": "sum by (channel) (increase(transactions_processed_total[$__range]))",
          "legendFormat": "{{channel}}",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "channel",
              "Last *": "transactions"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "transactions",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Flagged amount percentiles",
      "description": "The value of individual flagged transactions, as quantiles rather than a mean. Flagged amounts are heavily skewed — a handful of very large transactions drag an average well above anything typical — so the median is what describes the normal case and p99 is what describes the exposure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyZAR",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8f1030"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50 (median)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mean"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fraud_amount_flagged_zar_bucket[$__rate_interval])))",
          "legendFormat": "p50 (median)"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraud_amount_flagged_zar_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fraud_amount_flagged_zar_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "expr": "sum(rate(fraud_amount_flagged_zar_sum[$__rate_interval])) / clamp_min(sum(rate(fraud_amount_flagged_zar_count[$__rate_interval])), 0.0001)",
          "legendFormat": "mean"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Flagged amount distribution",
      "description": "Every flagged transaction by value band. The bucket edges are round rand figures chosen to match how the amounts are actually generated, so a band lighting up maps to a recognisable class of transaction rather than an arbitrary boundary.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "cellValues": {
          "unit": "none"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Reds",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5,
          "fill": "dark-red"
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "yAxis": {
          "unit": "currencyZAR",
          "axisPlacement": "left"
        }
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(fraud_amount_flagged_zar_bucket[$__interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    }
  ]
}
