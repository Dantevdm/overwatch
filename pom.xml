<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.overwatch</groupId>
    <artifactId>overwatch</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Overwatch</name>
    <description>Fraud rule engine service</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/Dantevdm/overwatch/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>services/common</module>
        <module>services/rule-engine</module>
        <module>services/transaction-simulator</module>
        <module>services/fraud-engine</module>
        <module>services/fraud-api</module>
        <!-- Not a service. A command-line client over the same API the browser
             uses, built in the same reactor so it cannot drift from the
             endpoints it calls. -->
        <module>tools/overwatch-cli</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>3.1.1</springdoc.version>

        <!-- Quality tooling -->
        <!-- 0.8.13 is the first release that reads Java 25 bytecode. 0.8.12
             aborts on "Unsupported class file major version 69" while
             instrumenting, which fails `verify` on every module — the same
             lag documented for SpotBugs and PMD below, so all three analysers
             are pinned forward deliberately rather than left to defaults. -->
        <jacoco.version>0.8.13</jacoco.version>
        <spotbugs.plugin.version>4.10.4.0</spotbugs.plugin.version>
        <!-- Pinned explicitly, not left to whatever the plugin bundles. Static
             analysers lag new JDKs: SpotBugs before 4.10 cannot read Java 25
             bytecode at all (class file major version 69), and PMD only learned
             Java 25 in 7.18. Both would fail the build on a language version the
             compiler is perfectly happy with. -->
        <spotbugs.core.version>4.10.4</spotbugs.core.version>
        <findsecbugs.version>1.13.0</findsecbugs.version>
        <pmd.plugin.version>3.26.0</pmd.plugin.version>
        <pmd.core.version>7.27.0</pmd.core.version>
        <dependency-check.version>10.0.4</dependency-check.version>
        <!-- Coverage floor, overridden per module.
             The default is zero on purpose. Coverage is enforced where there is
             logic to cover: the domain model and the rule engine, which hold
             every decision worth asserting. The service modules are wiring —
             controllers, repositories, Kafka glue — and unit tests there mostly
             assert that a mock was called. Those are exercised by the CI stack
             job, which starts the whole compose stack and smoke-tests it.
             A number chosen to make a percentage look respectable is worse than
             an honest zero with an integration test behind it. -->
        <jacoco.line.coverage>0.00</jacoco.line.coverage>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.overwatch</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.overwatch</groupId>
                <artifactId>rule-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${pmd.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Coverage. Instruments during test, then enforces the floor at
                 verify so `mvn verify` is the single quality gate. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <!-- Declarations rather than behaviour. JPA entities are
                                 column mappings, DTOs are records, and a test that
                                 calls a getter proves nothing except that Java works. -->
                            <excludes>
                                <exclude>**/*Application.class</exclude>
                                <exclude>**/config/**</exclude>
                                <exclude>**/persistence/*Entity.class</exclude>
                                <exclude>**/dto/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Bug patterns and security. find-sec-bugs adds ~130 detectors for
                 injection, crypto misuse and unsafe deserialisation. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <dependencies>
                    <!-- Override the bundled analyser: only 4.10+ reads Java 25. -->
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>${spotbugs.core.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <includeTests>false</includeTests>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/tools/quality/spotbugs-exclude.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Complexity, dead code and common bad practice. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <dependencies>
                    <!-- Upgrading PMD at runtime. The plugin bundles an older core
                         that does not recognise Java 25 as a language version. -->
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.core.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.core.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <rulesets>
                        <ruleset>${maven.multiModuleProjectDirectory}/tools/quality/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <targetJdk>${java.version}</targetJdk>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Every module gets metrics and health endpoints. Observability is not opt-in. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
