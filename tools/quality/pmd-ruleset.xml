<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Overwatch"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        A curated set of rules that find defects, not a category import.

        Pulling in whole PMD categories produces enough noise on a Spring codebase
        that people stop reading the output, and a gate nobody reads is worse than
        no gate. Every rule below is listed deliberately, and the notable
        omissions are recorded at the bottom with the reason.
    </description>

    <!-- ===== Correctness ================================================= -->
    <rule ref="category/java/errorprone.xml/BrokenNullCheck"/>
    <rule ref="category/java/errorprone.xml/MisplacedNullCheck"/>
    <rule ref="category/java/errorprone.xml/CompareObjectsWithEquals"/>
    <rule ref="category/java/errorprone.xml/OverrideBothEqualsAndHashcode"/>
    <rule ref="category/java/errorprone.xml/UnconditionalIfStatement"/>
    <rule ref="category/java/errorprone.xml/UselessOperationOnImmutable"/>
    <rule ref="category/java/errorprone.xml/CloseResource"/>
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <!-- A catch that genuinely does nothing must say so in a comment. -->
            <property name="allowCommentedBlocks" value="true"/>
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/AvoidBranchingStatementAsLastInLoop"/>
    <rule ref="category/java/errorprone.xml/DontUseFloatTypeForLoopIndices"/>

    <!-- Money must never be a double. This is a fraud system; a rounding error
         here is a real defect, not a style preference. -->
    <rule ref="category/java/errorprone.xml/AvoidDecimalLiteralsInBigDecimalConstructor"/>

    <!-- ===== Concurrency ================================================= -->
    <!-- The engine is a Kafka consumer and the rule cache is shared state. -->
    <rule ref="category/java/multithreading.xml/DoubleCheckedLocking"/>
    <rule ref="category/java/multithreading.xml/NonThreadSafeSingleton"/>
    <rule ref="category/java/multithreading.xml/AvoidThreadGroup"/>

    <!-- ===== Dead code =================================================== -->
    <rule ref="category/java/bestpractices.xml/UnusedPrivateField"/>
    <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod"/>
    <rule ref="category/java/bestpractices.xml/UnusedLocalVariable"/>
    <rule ref="category/java/bestpractices.xml/UnusedAssignment"/>

    <!-- ===== Complexity ================================================== -->
    <!-- Thresholds set where a method genuinely becomes hard to hold in your
         head, not at the defaults, which flag ordinary switch statements. -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="14"/>
            <property name="classReportLevel" value="80"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="18"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml/NPathComplexity">
        <properties>
            <property name="reportLevel" value="500"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml/CollapsibleIfStatements"/>
    <rule ref="category/java/design.xml/SimplifiedTernary"/>
    <rule ref="category/java/design.xml/UselessOverridingMethod"/>

    <!--
      Deliberately NOT enforced, and why:

      AvoidInstantiatingObjectsInLoops — the rule engine builds a RuleContext per
        rule per transaction and replay builds a sample per hit. Both are correct;
        the rule would demand mutable reuse across iterations, which is worse.

      UnnecessaryImport — valuable, but it fails a build over something an IDE
        fixes on save. Reported by the IDE and by review, not by the gate.

      GuardLogStatement — parameterised logging already defers formatting.

      JUnitTestsShouldIncludeAssert / JUnitAssertionsShouldIncludeMessage — these
        fight JUnit 5 and AssertJ idioms and add nothing here.

      LawOfDemeter, OnlyOneReturn, and the commenting rules — style opinions this
        codebase does not share.
    -->
</ruleset>
