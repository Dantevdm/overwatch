<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.overwatch</groupId>
        <artifactId>overwatch</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <!-- Two levels up: the modules live under services/, so Maven's default
             guess of ../pom.xml would miss the parent and fall back to trying to
             resolve it from a repository, where it has never been published. -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fraud-api</artifactId>
    <name>Overwatch :: Fraud API</name>
    <description>REST API over transactions, alerts, rules and statistics</description>


    <properties>
        <!-- Wiring — controllers and repositories. Covered by the CI stack job. -->
        <jacoco.line.coverage>0.00</jacoco.line.coverage>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.overwatch</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Spring Boot 4 modularised auto-configuration: flyway-core on the
                 classpath is no longer enough to activate FlywayAutoConfiguration.
                 Without this starter Flyway loads, does nothing, logs nothing, and
                 the first sign of trouble is Hibernate failing schema validation
                 on a database with no tables in it. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Not for a listener: this service consumes nothing. It needs the
                 AdminClient for topic and consumer-group metadata, a consumer to
                 peek at recent messages, and a producer for the two stream
                 operations the dashboard offers. The starter brings all three,
                 and Boot's auto-configuration then reads the same
                 spring.kafka.* block the engine uses. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <!-- The replay endpoint runs the real rule implementations, not a
                 reimplementation of them. A what-if answer computed by different
                 code from the one in production is worse than no answer. -->
            <groupId>com.overwatch</groupId>
            <artifactId>rule-engine</artifactId>
        </dependency>

        <!-- Reports. Measured, not estimated: POI and its transitive tail
             (xmlbeans, commons-compress, the ooxml-lite schema jar) add 15MB to
             the fat jar and PDFBox a further 3.6MB. POI earns its share by
             writing a workbook whose charts are real Excel chart objects, so a
             reader can retarget a series or change a chart type instead of
             looking at a picture of one. Note ooxml-lite alone is 5.7MB and is
             the trimmed schema set — the full one is larger again, which is why
             ExcelReport draws a stacked area rather than stacked columns. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- The schema lives in /infra/database/migration, outside any module, so
                     it lands at the root of this service's own classpath rather
                     than inside a nested dependency jar — the one place Flyway's
                     classpath scanning is reliably able to read it. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-db-migrations</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}/infra/database/migration</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- The Postman collection is served for download by
                             PostmanController, so it must be on this service's
                             classpath. Copied from /tools/postman rather than
                             duplicated into src/main/resources: two copies of a
                             collection is two collections, and the one nobody
                             edits is the one that gets downloaded. -->
                        <id>copy-postman</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/postman</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}/tools/postman</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Produces the executable fat jar. spring-boot-starter-parent only
                 declares this plugin in pluginManagement, so an executable module
                 must opt in explicitly; without it Maven emits a plain library jar
                 with no Main-Class and the container dies with
                 "no main manifest attribute". -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
