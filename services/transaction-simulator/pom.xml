<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.overwatch</groupId>
        <artifactId>overwatch</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <!-- Two levels up: the modules live under services/, so Maven's default
             guess of ../pom.xml would miss the parent and fall back to trying to
             resolve it from a repository, where it has never been published. -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>transaction-simulator</artifactId>
    <name>Overwatch :: Transaction Simulator</name>
    <description>Generates realistic South African ZAR transaction events</description>


    <properties>
        <!-- The generator is tested; the Kafka publisher and control API are wiring. -->
        <jacoco.line.coverage>0.30</jacoco.line.coverage>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.overwatch</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <!-- The starter, not the bare spring-kafka library. Spring Boot 4
                 modularised auto-configuration: the library on the classpath no
                 longer brings KafkaAutoConfiguration with it, so KafkaTemplate,
                 @KafkaListener containers and KafkaAdmin are simply never
                 defined. The same change is why Flyway needs its own starter. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces the executable fat jar. spring-boot-starter-parent only
                 declares this plugin in pluginManagement, so an executable module
                 must opt in explicitly; without it Maven emits a plain library jar
                 with no Main-Class and the container dies with
                 "no main manifest attribute". -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
