<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.overwatch</groupId>
        <artifactId>overwatch</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <!-- Two levels up: the modules live under services/, so Maven's default
             guess of ../pom.xml would miss the parent and fall back to trying to
             resolve it from a repository, where it has never been published. -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fraud-engine</artifactId>
    <name>Overwatch :: Fraud Engine</name>
    <description>Rule evaluation, risk scoring and alert persistence</description>


    <properties>
        <!-- The repositories here really are wiring, and the entities and config
             are excluded from measurement anyway. The pipeline is not: calling
             TransactionProcessor "wiring" was how this module came to have no
             tests at all, while holding the decisions that matter most — that a
             shadow hit raises no alert, that a failed publish costs a
             notification and not a detection, and that a redelivered record is
             not scored twice. That is 93.9% of the measured set; the floor sits
             under it with room for a genuinely thin addition, not room for the
             pipeline to go untested again. -->
        <jacoco.line.coverage>0.80</jacoco.line.coverage>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.overwatch</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.overwatch</groupId>
            <artifactId>rule-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <!-- The starter, not the bare spring-kafka library. Spring Boot 4
                 modularised auto-configuration: the library on the classpath no
                 longer brings KafkaAutoConfiguration with it, so KafkaTemplate,
                 @KafkaListener containers and KafkaAdmin are simply never
                 defined. The same change is why Flyway needs its own starter. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Spring Boot 4 modularised auto-configuration: flyway-core on the
                 classpath is no longer enough to activate FlywayAutoConfiguration.
                 Without this starter Flyway loads, does nothing, logs nothing, and
                 the first sign of trouble is Hibernate failing schema validation
                 on a database with no tables in it. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- The schema lives in /infra/database/migration, outside any module, so
                     it lands at the root of this service's own classpath rather
                     than inside a nested dependency jar — the one place Flyway's
                     classpath scanning is reliably able to read it. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-db-migrations</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}/infra/database/migration</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Produces the executable fat jar. spring-boot-starter-parent only
                 declares this plugin in pluginManagement, so an executable module
                 must opt in explicitly; without it Maven emits a plain library jar
                 with no Main-Class and the container dies with
                 "no main manifest attribute". -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
