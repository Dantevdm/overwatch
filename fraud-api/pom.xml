<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.overwatch</groupId>
        <artifactId>overwatch</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fraud-api</artifactId>
    <name>Overwatch :: Fraud API</name>
    <description>REST API over transactions, alerts, rules and statistics</description>

    <dependencies>
        <dependency>
            <groupId>com.overwatch</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <!-- The replay endpoint runs the real rule implementations, not a
                 reimplementation of them. A what-if answer computed by different
                 code from the one in production is worse than no answer. -->
            <groupId>com.overwatch</groupId>
            <artifactId>rule-engine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces the executable fat jar. spring-boot-starter-parent only
                 declares this plugin in pluginManagement, so an executable module
                 must opt in explicitly; without it Maven emits a plain library jar
                 with no Main-Class and the container dies with
                 "no main manifest attribute". -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
