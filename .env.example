# Host port mappings for the Overwatch stack.
#
# Every service binds a default port on the host. If one of them collides with
# something already running (a local Postgres on 5432 is the usual culprit),
# copy this file to `.env` and change only the offending line — no need to edit
# docker-compose.yml.
#
#   cp .env.example .env
#
# Only the HOST side changes. Ports inside the compose network are fixed, so
# nothing else in the stack needs to know.

# PostgreSQL
OW_PG_PORT=5432

# Redpanda Kafka API (the admin API is intentionally not published)
OW_KAFKA_PORT=19092

# Application services
OW_API_PORT=8080
OW_SIMULATOR_PORT=8081
OW_ENGINE_PORT=8082

# Dashboard
OW_UI_PORT=5173

# Observability
OW_PROMETHEUS_PORT=9090
OW_GRAFANA_PORT=3000
